table inet homelab
delete table inet homelab

table inet homelab {
  chain ssh {
    type filter hook input priority filter; policy accept;

    # SSH, only on the main interface
    tcp dport 22 iifname "{{ ansible_facts.default_ipv4.interface }}" accept
    tcp dport 22 drop
  }

  # Prerouting for Wireguard
  chain wg-backbone {
    type filter hook prerouting priority mangle; policy accept;

    # Allows replies over the backbone to reach the peer
    iifname "wg-backbone" ct state established,related accept

    # Allows other peers to ping this one
    iifname "wg-backbone" icmp type echo-request accept

    # Allows the VPS to open connections to Traefik's wg-private entrypoint, for VPN users
    iifname "wg-backbone" ip saddr {{ wireguard['wg-backbone'].peers[wireguard['wg-backbone'].hub] }} tcp dport {{ traefik_private_nodeport }} accept

    # Doesn't allow anyone to initiate any other connection to the peer over the backbone
    iifname "wg-backbone" drop
  }

  # The VPS proxy reaches Traefik's wg-public entrypoint over the wg-public WireGuard network, nothing else comes in
  chain wg-public {
    type filter hook prerouting priority mangle; policy accept;

    # Allows replies to reach the node
    iifname "wg-public" ct state established,related accept

    # Allows the VPS to open connections to Traefik's wg-public entrypoint
    iifname "wg-public" ip saddr {{ wireguard['wg-public'].peers[wireguard['wg-public'].hub] }} tcp dport {{ traefik_public_nodeport }} accept

    # Doesn't allow anything else in over this network
    iifname "wg-public" drop
  }
}
