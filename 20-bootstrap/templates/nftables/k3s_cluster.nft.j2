table inet homelab
delete table inet homelab

table inet homelab {
  chain ssh {
    type filter hook input priority filter; policy accept;

    # SSH, only on the main interface
    tcp dport 22 iifname "{{ ansible_facts.default_ipv4.interface }}" accept
    tcp dport 22 drop
  }

  # The WireGuard chains hook prerouting: kube-proxy rewrites a NodePort to the pod's address and port right after, so later hooks no longer see it
  chain wg-trusted {
    type filter hook prerouting priority mangle; policy accept;

    # Allows replies over the wg-trusted to reach the peer
    iifname "wg-trusted" ct state established,related accept

    # Allows other peers to ping this one
    iifname "wg-trusted" icmp type echo-request accept

    # Allows the VPS to open connections to Traefik's wg-trusted entrypoint, for VPN users
    iifname "wg-trusted" ip saddr {{ wireguard['wg-trusted'].peers[wireguard['wg-trusted'].hub] }} tcp dport {{ traefik_private_nodeport }} accept

    # Doesn't allow anyone to initiate any other connection to the peer over the wg-trusted
    iifname "wg-trusted" drop
  }

  # The VPS proxy reaches Traefik's wg-untrusted entrypoint, nothing else comes in
  chain wg-untrusted {
    type filter hook prerouting priority mangle; policy accept;

    # Allows replies to reach the node
    iifname "wg-untrusted" ct state established,related accept

    # Allows the VPS to open connections to Traefik's wg-untrusted entrypoint
    iifname "wg-untrusted" ip saddr {{ wireguard['wg-untrusted'].peers[wireguard['wg-untrusted'].hub] }} tcp dport {{ traefik_public_nodeport }} accept

    # Doesn't allow anything else in over this network
    iifname "wg-untrusted" drop
  }
}
