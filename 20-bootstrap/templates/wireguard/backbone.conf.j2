
[Interface]
Address = {{ wireguard_backbone.peers[inventory_hostname] }}/{{ wireguard_backbone.cidr.split('/')[1] }}
PostUp = wg set %i private-key /etc/wireguard/%i.key
{% if inventory_hostname ==  wireguard_backbone.hub %}
ListenPort = {{ wireguard_backbone.port }}


{% for name, address in wireguard_backbone.peers.items() if name !=  wireguard_backbone.hub %}
# {{ name }}
[Peer]
PublicKey = {{ hostvars[name]._backbone_public_key.stdout }}
AllowedIPs = {{ address }}/32
{% endfor %}


{% else %}

# {{  wireguard_backbone.hub }}
[Peer]
PublicKey = {{ hostvars[ wireguard_backbone.hub]._backbone_public_key.stdout }}
Endpoint = {{ hostvars[ wireguard_backbone.hub].ansible_host }}:{{ wireguard_backbone.port }}
# Every peer is reachable through the server, each peer filters what it accepts
AllowedIPs = {{ wireguard_backbone.cidr }}
PersistentKeepalive = 25
{% endif %}
