{
    "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
    "packages": {
        "ansible": "2.21.1",
        "opentofu": "1.12.5",
        "ansible-navigator": "26.6.0",
        "kubectl": "1.36.3",
        "podman": {
            "version": "5.8.4",
            "excluded_platforms": [
                "aarch64-darwin",
                "x86_64-darwin"
            ]
        },
        "ansible-builder": "3.1.1",
        "kubernetes-helm": "4.2.3",
        "helmfile": "1.6.0",
        "sops": "3.13.2",
        "age": "1.3.1",
        "pre-commit": "4.5.1",
        "restic": "0.19.1",
        "k9s": "0.51.0"
    },
    "shell": {
        "init_hook": [
            ". \"$DEVBOX_PROJECT_ROOT/env.sh\""
        ],
        "scripts": {
            "sops-check": [
                "\"$DEVBOX_PROJECT_ROOT/scripts/sops-check\" \"$@\""
            ],
            "sops-toggle": [
                "\"$DEVBOX_PROJECT_ROOT/scripts/sops-toggle\" \"$@\""
            ],
            "sops-stage": [
                "\"$DEVBOX_PROJECT_ROOT/scripts/sops-stage\""
            ],
            "sops-open": [
                "\"$DEVBOX_PROJECT_ROOT/scripts/sops-open\" \"$@\""
            ],
            "sops-seal": [
                "\"$DEVBOX_PROJECT_ROOT/scripts/sops-seal\" \"$@\""
            ]
        }
    }
}