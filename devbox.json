{
    "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
    "packages": [
        "ansible@2.21.1",
        "opentofu@1.12.3",
        "ansible-navigator@26.4.0",
        "kubectl@1.36.2",
        "podman@5.8.4",
        "ansible-builder@3.1.1",
        "kubernetes-helm@4.2.2",
        "helmfile@1.6.0",
        "sops@3.13.1",
        "age@1.3.1",
        "pre-commit@4.5.1"
    ],
    "shell": {
        "init_hook": [
            ". \"$DEVBOX_PROJECT_ROOT/env.sh\""
        ],
        "scripts": {
            "sops-encrypt": [
                "\"$DEVBOX_PROJECT_ROOT/scripts/sops-encrypt\" \"$@\""
            ],
            "sops-decrypt": [
                "\"$DEVBOX_PROJECT_ROOT/scripts/sops-decrypt\" \"$@\""
            ],
            "sops-toggle": [
                "\"$DEVBOX_PROJECT_ROOT/scripts/sops-toggle\" \"$@\""
            ],
            "tfvars-sync": [
                "\"$DEVBOX_PROJECT_ROOT/scripts/tfvars-sync\" \"$@\""
            ],
            "tfvars-restore": [
                "\"$DEVBOX_PROJECT_ROOT/scripts/tfvars-restore\""
            ],
            "tfvars-check": [
                "\"$DEVBOX_PROJECT_ROOT/scripts/tfvars-check\""
            ]
        }
    }
}