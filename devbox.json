{
    "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
    "packages": [
        "ansible@2.21.1",
        "opentofu@1.12.3",
        "ansible-navigator@26.4.0",
        "kubectl@1.36.2",
        "podman@5.8.4",
        "ansible-builder@3.1.1",
        "sops@3.13.1",
        "age@1.3.1",
        "pre-commit@4.5.1"
    ],
    "shell": {
        "init_hook": [
            "export KUBECONFIG=\"$DEVBOX_PROJECT_ROOT/ansible/kubeconfig.yaml\"",
            "export SOPS_AGE_KEY_FILE=\"$DEVBOX_PROJECT_ROOT/.sops/keys.txt\"",
            "command -v pre-commit >/dev/null && [ ! -f \"$(git rev-parse --git-path hooks/pre-commit 2>/dev/null)\" ] && pre-commit install >/dev/null 2>&1 || true"
        ],
        "scripts": {
            "sops-encrypt": [
                "\"$DEVBOX_PROJECT_ROOT/scripts/sops-encrypt\" \"$@\""
            ],
            "sops-decrypt": [
                "\"$DEVBOX_PROJECT_ROOT/scripts/sops-decrypt\" \"$@\""
            ],
            "sops-toggle": [
                "\"$DEVBOX_PROJECT_ROOT/scripts/sops-toggle\" \"$@\""
            ]
        }
    }
}