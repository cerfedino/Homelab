{
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "code-runner.ignoreSelection": true,
  "code-runner.executorMapByGlob": {
    "execution-environment.yml": "cd $dir && ansible-builder build --tag ansible_ee",
    "playbook-*.yaml": "cd $dir && ansible-navigator run $fileName",
    // "requirements.yml": "cd $dir && ansible-galaxy install -r $fileName",
    "main.tofu": "cd $dir && tofu validate && ./generate_ansible_data.sh",

    // Tries to toggle encryption on every yaml file in case its a k3s SOPS-encrypted secret
    "*.yaml": "cd $workspaceRoot && devbox run sops-toggle $fullFileName",
    "*.yml": "cd $workspaceRoot && devbox run sops-toggle $fullFileName"
  }
}
