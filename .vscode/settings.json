{
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "code-runner.ignoreSelection": true,
  "code-runner.executorMapByGlob": {
    "execution-environment.yml": "cd $dir && ansible-builder build --tag ansible_ee",
    "playbook-*.yaml": "cd $dir && ansible-navigator run $fileName",
    // "requirements.yml": "cd $dir && ansible-galaxy install -r $fileName",
    "main.tofu": "cd $dir && tofu validate && source generate_stage_data.sh",

    "helmfile.yaml": "cd $dir && helmfile apply",

    // Toggle secret files between encrypted and cleartext
    "*.enc*": "cd $workspaceRoot && devbox run sops-toggle $fullFileName"
  },
  "[opentofu]": {
    "editor.defaultFormatter": "opentofu.vscode-opentofu"
  }
}
