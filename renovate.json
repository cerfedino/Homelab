{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "minimumReleaseAge": "14 days",
    "minimumReleaseAgeBehaviour": "timestamp-optional",
    "kubernetes": {
        "managerFilePatterns": [
            "/^30-applications/.+/extras/.+\\.yaml$/"
        ]
    },
    "helm-values": {
        "managerFilePatterns": [
            "/^30-applications/.+/values.*\\.yaml$/"
        ]
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "Container images in gotmpl-templated manifests",
            "managerFilePatterns": [
                "/^30-applications/.+/extras/.+\\.yaml\\.gotmpl$/"
            ],
            "matchStrings": [
                "image: (?<depName>[a-z0-9.\\-/]+):(?<currentValue>[a-zA-Z0-9][\\w.\\-]*)"
            ],
            "datasourceTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "Anything carrying a `# renovate:` annotation",
            "managerFilePatterns": [
                "/^(10-infra|20-bootstrap|30-applications)/.+\\.(yaml|yml|gotmpl|tofu)$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+[^\\n]*?[:=]\\s*\"?(?<currentValue>[\\w.+\\-]+)\"?"
            ]
        },
        {
            "customType": "regex",
            "description": "k3s version pin",
            "managerFilePatterns": [
                "/^20-bootstrap/group_vars/k3s_cluster/vars\\.yaml$/"
            ],
            "matchStrings": [
                "k3s_version: (?<currentValue>v[\\d.]+\\+k3s\\d+)"
            ],
            "depNameTemplate": "k3s-io/k3s",
            "datasourceTemplate": "github-releases"
        },
        {
            "customType": "regex",
            "description": "ansible-navigator execution environment base image",
            "managerFilePatterns": [
                "/^20-bootstrap/execution-environment\\.yml$/"
            ],
            "matchStrings": [
                "name: (?<depName>[a-z0-9.\\-/]+):(?<currentValue>[\\w.\\-]+)"
            ],
            "datasourceTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "description": "Majors wait on the dashboard instead of opening a PR",
            "matchUpdateTypes": [
                "major"
            ],
            "dependencyDashboardApproval": true
        },
        {
            "description": "A k3s minor is a rolling node upgrade",
            "matchDepNames": [
                "k3s-io/k3s"
            ],
            "matchUpdateTypes": [
                "minor"
            ],
            "dependencyDashboardApproval": true
        },
        {
            "description": "Patches merge themselves",
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": true
        },
        {
            "description": "The media stack is redeployed as one unit",
            "matchFileNames": [
                "30-applications/media/values-*.yaml"
            ],
            "groupName": "media stack"
        },
        {
            "description": "linuxserver repos have shit legacy tags",
            "matchPackageNames": [
                "lscr.io/linuxserver/**"
            ],
            "allowedVersions": "!/^(\\d{2}\\.(04|10)(\\.|$)|14\\.3\\.)/"
        }
    ]
}