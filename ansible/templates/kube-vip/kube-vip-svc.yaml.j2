# kube-vip DaemonSet for SVC VIP election, one pod for every node.

# Watches Services carrying a kube-vip.io/loadbalancerIPs annotation and ARPs those VIPs, one lease/election per Service. Such that when an in bound connection arrives at the VIP, it will be routed to one of the nodes that is running a pod for that Service.

---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: kube-vip-ds-svc
  namespace: kube-system
  labels:
    app.kubernetes.io/name: kube-vip-ds-svc
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: kube-vip-ds-svc
  template:
    metadata:
      labels:
        app.kubernetes.io/name: kube-vip-ds-svc
    spec:
      containers:
        - name: kube-vip
          image: ghcr.io/kube-vip/kube-vip:v0.8.9
          args: ["manager"]
          env:
            - name: vip_arp # layer-2 mode: announce via ARP
              value: "true"
            - name: vip_leaseduration
              value: "5"
            - name: vip_renewdeadline
              value: "3"
            - name: vip_retryperiod
              value: "1"

            - name: cp_enable
              value: "false"
            - name: svc_enable # watch LoadBalancer Services and announce their VIPs
              value: "true"
            - name: svc_election # one election per Service: VIPs spread and fail over independently
              value: "true"

            - name: vip_interface # which NIC to announce on (the LAN one)
              value: "{{ kube_vip_svc_interface }}"
          securityContext:
            capabilities:
              add: ["NET_ADMIN", "NET_RAW"] # needed to bind the VIP + send ARP
      hostNetwork: true # kube-vip manipulates the host's network stack
      serviceAccountName: kube-vip
      # Tolerate control-plane taints so it can schedule even if they're tainted / not-ready during a restart.
      tolerations:
        - effect: NoSchedule
          operator: Exists
        - effect: NoExecute
          operator: Exists
