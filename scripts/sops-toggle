#!/usr/bin/env bash
# Flip each given secrets file between encrypted and plaintext.
# Requires a file path
set -euo pipefail
[ "$#" -gt 0 ] || { echo "sops-toggle: requires a file path" >&2; exit 1; }

for f in "$@"; do
  case "${f##*/}" in .sops.yaml|.sops.yml) echo "skip (sops config) $f"; continue ;; *.tfvars.sops.yaml) echo "skip (managed by tfvars-sync/restore) $f"; continue ;; *.sops.yaml|*.sops.yml) : ;; *) echo "skip (not a .sops file) $f"; continue ;; esac
  if sops filestatus "$f" 2>/dev/null | grep -q '"encrypted": *true'; then
    echo "decrypting $f"; sops -d -i "$f"
  else
    echo "encrypting $f"; sops -e -i "$f"
  fi
done
