#!/usr/bin/env bash
# Fail if any given secrets file is in cleartext (sops filestatus).
# --staged checks the git index copy instead of the worktree file
set -euo pipefail

staged=0
[ "${1:-}" = "--staged" ] && { staged=1; shift; }

encrypted() { sops filestatus --input-type "$1" "$2" 2>/dev/null | grep -q '"encrypted": *true'; }

rc=0
for f in "$@"; do
  case "${f##*/}" in
    *.yaml | *.yml | *.yaml.* | *.yml.*) store=yaml ;;
    *.json | *.json.*)                   store=json ;;
    *)                                   store=binary ;;
  esac
  # Check the file in the stage index
  if [ "$staged" = 1 ]; then
    tmp="$(mktemp)"
    git show ":$f" > "$tmp" 2>/dev/null || true
    encrypted "$store" "$tmp" || { echo "not encrypted in index: $f  (fix: devbox run sops-stage)" >&2; rc=1; }
    rm -f "$tmp"
  # Otherwise on disk
  else
    encrypted "$store" "$f" || { echo "not encrypted: $f  (fix: devbox run sops-stage)" >&2; rc=1; }
  fi
done
exit $rc
