#!/usr/bin/env bash
# Decrypt SOPS secrets in place
set -euo pipefail

if [ "$#" -gt 0 ]; then
  files=("$@")
else
  mapfile -t files < <(find . -type f \( -name '*.sops.yaml' -o -name '*.sops.yml' \) ! -name '.sops.yaml' ! -name '.sops.yml')
fi

for f in "${files[@]}"; do
  case "${f##*/}" in .sops.yaml|.sops.yml) echo "skip (sops config) $f"; continue ;; *.sops.tfvars) echo "skip (managed by tfvars-restore) $f"; continue ;; esac
  if sops filestatus "$f" 2>/dev/null | grep -q '"encrypted": *true'; then
    echo "decrypting $f"; sops -d -i "$f"
  else
    echo "skip (already plaintext) $f"
  fi
done
