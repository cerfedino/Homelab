#!/usr/bin/env bash
# Decrypt SOPS secrets in place
set -euo pipefail

if [ "$#" -gt 0 ]; then
  files=("$@")
else
  mapfile -t files < <(find . -type f \( -name '*.yaml' -o -name '*.yml' \) -path '*/secrets/*')
fi

for f in "${files[@]}"; do
  if sops filestatus "$f" 2>/dev/null | grep -q '"encrypted": *true'; then
    echo "decrypting $f"; sops -d -i "$f"
  else
    echo "skip (already plaintext) $f"
  fi
done
