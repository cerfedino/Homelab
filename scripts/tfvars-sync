#!/usr/bin/env bash
# Encrypt *.tfvars files into their committed *.sops.tfvars mirrors
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "$#" -gt 0 ]; then
  files=("$@")
else
  mapfile -t files < <(find . -type f -name '*.tfvars' ! -name '*.sops.tfvars' -not -path '*/.terraform/*')
fi

for f in "${files[@]}"; do
  case "${f##*/}" in *.sops.tfvars) echo "skip (already a mirror) $f"; continue ;; esac
  enc="${f%.tfvars}.sops.tfvars"
  sops -e --input-type binary --output-type json "$f" > "$enc"
  echo "synced $enc"
done
