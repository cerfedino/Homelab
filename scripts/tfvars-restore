#!/usr/bin/env bash
# Restore *.tfvars files from their committed *.sops.tfvars mirrors
set -euo pipefail
cd "$(dirname "$0")/.."

mapfile -t files < <(find . -type f -name '*.sops.tfvars' -not -path '*/.terraform/*')

for enc in "${files[@]}"; do
  plain="${enc%.sops.tfvars}.tfvars"
  sops -d --input-type json --output-type binary "$enc" > "$plain"
  echo "restored $plain"
done
