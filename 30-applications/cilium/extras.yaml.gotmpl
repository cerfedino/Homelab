{{- $app := readFile "app.enc.yaml" | fromYaml }}
networkpolicies:
  hubble-ui:
    forceRename: traefik-ingress-hubble-ui
    podSelector:
      matchExpressions:
        - key: app.kubernetes.io/name
          operator: In
          values:
            - hubble-ui
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: traefik

rawResources:
  internal:
    forceRename: hubble-internal
    manifest:
      apiVersion: traefik.io/v1alpha1
      kind: IngressRoute
      spec:
        entryPoints: [lan-https]
        routes:
          - match: Host(`{{ $app.internal.dns_hostname }}`)
            kind: Rule
{{- if eq $app.internal.type "forward-auth" }}
            middlewares:
              - name: authentik-forward-auth-local@file
{{- end }}
            services:
              - name: hubble-ui
                port: 80
