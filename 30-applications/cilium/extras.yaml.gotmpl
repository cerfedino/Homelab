{{- $app := readFile "app.enc.yaml" | fromYaml }}
{{- $host := index $app.hosts 0 }}
networkpolicies:
  hubble-ui:
    forceRename: traefik-ingress-hubble-ui
    podSelector:
      matchExpressions:
        - key: app.kubernetes.io/name
          operator: In
          values:
            - hubble-ui
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: traefik

rawResources:
  hubble:
    forceRename: hubble
    manifest:
      apiVersion: traefik.io/v1alpha1
      kind: IngressRoute
      spec:
        entryPoints: [lan-https]
        routes:
          - match: Host(`{{ $host }}`)
            kind: Rule
            middlewares:
              - name: authentik-forward-auth@file
            services:
              - name: hubble-ui
                port: 80
