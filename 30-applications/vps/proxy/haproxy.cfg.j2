global
    log stdout format raw local0

defaults
    log global
    timeout connect 5s
    timeout client 1h
    timeout server 1h

frontend http
    mode http
    bind :80
    http-request redirect scheme https code 301

frontend https
    mode tcp
    bind :443
    default_backend nodes

# send-proxy-v2 tells Traefik the visitor's address
backend nodes
    mode tcp
{% for name, address in wireguard.apps.peers.items() if name != wireguard.apps.hub %}
    server {{ name }} {{ address }}:{{ traefik_public_nodeport }} send-proxy-v2 check
{% endfor %}
