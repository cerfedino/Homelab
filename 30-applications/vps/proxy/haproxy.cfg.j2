{% set wg_untrusted = wireguard['wg-untrusted'] %}
{% set wg_users = wireguard['wg-users'] %}
{% set wg_trusted = wireguard['wg-trusted'] %}
global
    log stdout format raw local0
    user haproxy
    group haproxy
    chroot auto

defaults
    log global
    timeout connect 5s
    timeout client 1h
    timeout server 1h

frontend http
    mode http
    bind :80
    http-request redirect scheme https code 301

frontend https
    mode tcp
    bind :443
    # VPN users get the private entrypoint, everyone else the public one
    use_backend wg-trusted if { src {{ wg_users.cidr }} }
    default_backend wg-untrusted

# send-proxy-v2 tells Traefik the visitor's address
backend wg-untrusted
    mode tcp
{% for name, address in wg_untrusted.peers.items() if name != wg_untrusted.hub %}
    server {{ name }} {{ address }}:{{ traefik_public_nodeport }} send-proxy-v2 check
{% endfor %}

# The nodes are not on wg-users, the proxy reaches them over wg-trusted
backend wg-trusted
    mode tcp
{% for name, address in wg_trusted.peers.items() if name in groups['k3s_cluster'] %}
    server {{ name }} {{ address }}:{{ traefik_private_nodeport }} send-proxy-v2 check
{% endfor %}
