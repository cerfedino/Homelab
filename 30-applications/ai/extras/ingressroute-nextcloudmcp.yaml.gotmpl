apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: nextcloud-mcp
spec:
  entryPoints:
    - websecure
  routes:
{{- range $variant, $v := .Values.apps.nextcloudmcp }}
{{- if $v.dns_hostname }}
    - match: Host(`{{ $v.dns_hostname }}`)
      kind: Rule
      services:
        - name: nextcloud-mcp
          port: 8001
      middlewares:
        - name: authentik-forward-auth-local@file
{{- end }}
{{- end }}
