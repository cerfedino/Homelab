apiVersion: v1
kind: ConfigMap
metadata:
  name: librechat-config
data:
  librechat.yaml: |
    version: 1.3.14
    cache: true

    # seeds USER role permissions at startup: MCP use only
    interface:
      mcpServers:
        use: true
        create: false
        share: false
        public: false

    endpoints:
      custom:
        - name: LiteLLM
          apiKey: '${LITELLM_API_KEY}'
          baseURL: http://litellm.ai.svc.cluster.local:4000/v1
          models:
            default:
              - claude-sonnet-5
            fetch: true
          titleConvo: true
          titleModel: claude-haiku-4-5
          modelDisplayLabel: LiteLLM

    mcpServers:
      hevy:
        type: stdio
        command: npx
        args:
          - -y
          - 'hevy-mcp'
        env:
          HEVY_API_KEY: '{{"{{"}}HEVY_API_KEY{{"}}"}}'
        customUserVars:
          HEVY_API_KEY:
            title: Hevy API Key
            description: Get API key at https://hevy.com/settings?developer
            sensitive: true
        startup: false
      yazio:
        type: stdio
        command: npx
        args:
          - -y
          - 'yazio-mcp'
        env:
          YAZIO_USERNAME: '{{"{{"}}YAZIO_USERNAME{{"}}"}}'
          YAZIO_PASSWORD: '{{"{{"}}YAZIO_PASSWORD{{"}}"}}'
        customUserVars:
          YAZIO_USERNAME:
            title: Username
            description: Your YAZIO username
            sensitive: false
          YAZIO_PASSWORD:
            title: Password
            description: Your YAZIO password
            sensitive: true
        startup: false
