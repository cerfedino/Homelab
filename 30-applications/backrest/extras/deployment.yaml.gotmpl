apiVersion: apps/v1
kind: Deployment
metadata:
  name: backrest
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: backrest
  template:
    metadata:
      labels:
        app: backrest
        app.kubernetes.io/name: backrest
      annotations:
        checksum/config-seed: {{ tpl (readFile "extras/config-secret.yaml.gotmpl") $ | sha256sum }}
    spec:
      initContainers:
        - name: seed-config
          image: busybox:1.38
          command:
            - sh
            - -c
            - "mkdir -p /data/config && cp /seed/config.json /data/config/config.json"
          volumeMounts:
            - name: data
              mountPath: /data
            - name: config-seed
              mountPath: /seed
      containers:
        - name: backrest
          image: ghcr.io/garethgeorge/backrest:v1.14.1
          env:
            - name: TZ
              value: "Europe/Zurich"
            - name: BACKREST_PORT
              value: "0.0.0.0:9898"
            - name: BACKREST_DATA
              value: "/data/data"
            - name: BACKREST_CONFIG
              value: "/data/config/config.json"
            - name: XDG_CACHE_HOME
              value: "/data/cache"
          ports:
            - containerPort: 9898
          volumeMounts:
            - name: data
              mountPath: /data
          resources:
            limits:
              memory: "512Mi"
          readinessProbe:
            httpGet:
              path: /
              port: 9898
            initialDelaySeconds: 5
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: backrest-data
        - name: config-seed
          secret:
            secretName: backrest-config-seed
