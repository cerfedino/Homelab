apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: cloudflare-tunnel
  name: cloudflared-deployment
  namespace: cloudflare-tunnel
spec:
  replicas: 3
  selector:
    matchLabels:
      pod: cloudflare-tunnel
  template:
    metadata:
      labels:
        pod: cloudflare-tunnel
    spec:
      containers:
        - command:
            - cloudflared
            - tunnel
            - --metrics
            - 0.0.0.0:2000
            - run
          args:
            - --token
            #prettier-ignore
            - {{ .Values.cloudflareTunnelToken }}
          image: cloudflare/cloudflared:latest
          name: cloudflare-tunnel
          livenessProbe:
            httpGet:
              path: /ready
              port: 2000
            failureThreshold: 1
            initialDelaySeconds: 10
            periodSeconds: 10
