{{- $secrets := fromYaml (readFile "values.enc.yaml") }}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: windmill-postgres
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: windmill-postgres
  template:
    metadata:
      labels:
        app: windmill-postgres
      annotations:
        k8up.io/backupcommand: sh -c 'PGPASSWORD="$POSTGRES_PASSWORD" pg_dump --clean --if-exists -U "$POSTGRES_USER" "$POSTGRES_DB"'
        k8up.io/file-extension: .sql
    spec:
      containers:
        - name: postgres
          image: postgres:18.6
          env:
            # subdirectory: initdb refuses the mount point itself (lost+found)
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
            - name: POSTGRES_USER
              value: windmill
            - name: POSTGRES_DB
              value: windmill
            - name: POSTGRES_INITDB_ARGS
              value: "--data-checksums"
            - name: POSTGRES_PASSWORD
              value: {{ $secrets.windmill_postgres_password | quote }}
          ports:
            - containerPort: 5432
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              memory: "1Gi"
              cpu: "1"
          readinessProbe:
            exec:
              command: ["pg_isready", "-U", "windmill", "-d", "windmill"]
            initialDelaySeconds: 10
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: windmill-postgres-data
