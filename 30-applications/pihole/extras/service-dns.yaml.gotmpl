apiVersion: v1
kind: Service
metadata:
  name: pihole-dns
  annotations:
    kube-vip.io/loadbalancerIPs: {{ .Values.pihole_svc_address | quote }}
spec:
  type: LoadBalancer
  externalTrafficPolicy: Local
  selector:
    app: pihole
  ports:
    - name: dns-udp
      port: 53
      targetPort: 53
      protocol: UDP
    - name: dns-tcp
      port: 53
      targetPort: 53
      protocol: TCP
