apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: pihole
spec:
  entryPoints:
    - websecure
  routes:
{{- range $variant, $v := .Values.apps.pihole }}
{{- if $v.dns_hostname }}
    - match: Host(`{{ $v.dns_hostname }}`)
      kind: Rule
      services:
        - name: pihole-web
          port: 80
{{- if eq $v.type "forward-auth" }}
      middlewares:
        - name: authentik-forward-auth-{{ eq $variant "internal" | ternary "local" "external" }}@file
{{- end }}
{{- end }}
{{- end }}
