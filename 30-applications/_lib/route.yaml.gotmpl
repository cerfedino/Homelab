{{- $first := true }}
{{- range $variant, $v := index .Values.apps .app }}
{{- if $v.dns_hostname }}
{{- if not $first }}
---
{{- end }}
{{- $first = false }}
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ $.name }}-{{ $variant }}
spec:
  entryPoints:
    - {{ eq $variant "internal" | ternary "lan-https" "cloudflared" }}
  routes:
    - match: Host(`{{ $v.dns_hostname }}`)
      kind: Rule
      services:
        - name: {{ $.service }}
          port: {{ $.port }}
{{- if eq $v.type "forward-auth" }}
      middlewares:
        - name: authentik-forward-auth-{{ eq $variant "internal" | ternary "local" "external" }}@file
{{- end }}
{{- end }}
{{- end }}
