apiVersion: k8up.io/v1
kind: Schedule
metadata:
  name: backup
spec:
  backend:
    s3:
      endpoint: {{ .Values.backup.s3_endpoint }}
      bucket: {{ .Values.backup.s3_bucket }}/{{ .bucket }}
  backup:
    podSecurityContext:
      runAsUser: 0
    schedule: "0 2 * * *"
    failedJobsHistoryLimit: 2
    successfulJobsHistoryLimit: 2
{{- if hasKey . "matchLabels" }}
    labelSelectors:
      - matchLabels:
{{ toYaml .matchLabels | indent 10 }}
{{- end }}
  check:
    schedule: "0 3 * * 6"
  prune:
    schedule: "0 3 * * 0"
    retention:
      keepDaily: 14
      keepWeekly: 8
      keepMonthly: 12
