{{- $app := readFile "app.enc.yaml" | fromYaml }}
{{- $host := index $app.hosts 0 }}
networkpolicies:
  namespace:
    podSelector: {}
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - podSelector: {}
        - from:
            # Allow for Jellyfin LDAP access
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: media
              podSelector:
                matchLabels:
                  app.kubernetes.io/name: jellyfin
          ports:
            - port: 3389
            - port: 6636
  traefik-server:
    # the authentik chart's server pods, deployed by the authentik release
    podSelector:
      matchExpressions:
        - key: app.kubernetes.io/name
          operator: In
          values:
            - authentik
        - key: app.kubernetes.io/component
          operator: In
          values:
            - server
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: traefik
  traefik-outpost-proxy:
    # the external outpost pods, created by authentik itself
    podSelector:
      matchExpressions:
        - key: app.kubernetes.io/name
          operator: In
          values:
            - authentik-outpost-proxy
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: traefik

rawResources:
  authentik:
    forceRename: authentik
    manifest:
      apiVersion: traefik.io/v1alpha1
      kind: IngressRoute
      spec:
        entryPoints: [lan-https, wg-private]
        routes:
          - match: Host(`{{ $host }}`)
            kind: Rule
            services:
              - name: authentik-server
                port: 80
  authentik-local:
    forceRename: authentik-local
    manifest:
      apiVersion: traefik.io/v1alpha1
      kind: IngressRoute
      spec:
        entryPoints: [lan-https]
        routes:
          - match: Host(`{{ index $app.hosts 1 }}`)
            kind: Rule
            services:
              - name: authentik-server
                port: 80
  backup:
    forceRename: backup
    manifest:
      apiVersion: k8up.io/v1
      kind: Schedule
      spec: {{ (tpl (readFile "../_lib/schedule.yaml.gotmpl") (dict "bucket" "authentik" "Values" .Values) | fromYaml).spec | toYaml | nindent 8 }}
