{{- $hosts := list }}
{{- range $variant, $v := .Values.apps.authentik }}
{{- if $v.dns_hostname }}{{- $hosts = append $hosts (printf "Host(`%s`)" $v.dns_hostname) }}{{- end }}
{{- end }}
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: authentik-server
  namespace: "authentik"
  labels:
    app.kubernetes.io/name: "authentik"
    app.kubernetes.io/instance: "authentik"
    app.kubernetes.io/component: "server"
    app.kubernetes.io/managed-by: "Helm"
    app.kubernetes.io/part-of: "authentik"
spec:
  entryPoints:
    - websecure
  routes:
    - match: {{ join " || " $hosts }}
      kind: Rule
      services:
        - name: authentik-server
          port: 80
