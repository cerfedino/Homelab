{{- $app := readFile "app.enc.yaml" | fromYaml }}
{{- $host := index $app.hosts 0 }}
{{- $wgPublic := index .Values.wireguard "wg-public" }}
{{- $wgBackbone := index .Values.wireguard "wg-backbone" }}
# Note to self: In order to have the actual LAN ip of a local client show up, I have to make sure that a traefik pod is guaranteed to run on the same node that is reached through the LAN kube-VIP, because otherwise kube-proxy would rewrite the source IP when forwarding the traffic to a node that has a traefik pod running. That's why we make Traefik a DaemonSet.

service:
  spec:
    type: LoadBalancer
    externalTrafficPolicy: Local
  annotations:
    # prettier-ignore
    kube-vip.io/loadbalancerIPs: {{ .Values.kube_vip_svc_address | quote }}
  additionalServices:
    # Answers on every node, reached only by the VPS over the wg-public WireGuard network
    wg-public:
      spec:
        type: NodePort
        externalTrafficPolicy: Local
    # Same for the wg-private entrypoint, over the wg-backbone WireGuard network
    wg-private:
      spec:
        type: NodePort
        externalTrafficPolicy: Local

deployment:
  kind: DaemonSet
  # External dynamic traefik config
  additionalVolumes:
    - name: dynamic
      configMap:
        name: traefik-dynamic
        optional: true # don't block pod start while the CM doesn't exist yet

podDisruptionBudget:
  enabled: true
  minAvailable: 1

additionalVolumeMounts:
  - name: dynamic
    mountPath: /dynamic
    readOnly: true

providers:
  kubernetesCRD:
    enabled: true # IngressRoutes for in-cluster apps
  kubernetesIngress:
    enabled: false # not using plain Ingress objects
  kubernetesGateway:
    enabled: false # no Gateway API (IngressRoute only)

gateway:
  enabled: false
gatewayClass:
  enabled: false

# entrypoints
ports:
  web: null
  websecure: null
  lan-http:
    port: 80
    exposedPort: 80
    expose:
      default: true
    http:
      redirections:
        entryPoint:
          to: lan-https
          scheme: https
          permanent: true
  lan-https:
    port: 443
    exposedPort: 443
    expose:
      default: true
    http:
      tls:
        enabled: true
    transport:
      respondingTimeouts:
        readTimeout: 0
  # Public apps, only reachable by the VPS over the wg-public WireGuard network
  wg-public:
    port: 8444
    nodePort: {{ .Values.traefik_public_nodeport }}
    expose:
      default: false
      wg-public: true
    http:
      tls:
        enabled: true
    # The VPS proxy passes the visitor's address
    proxyProtocol:
      trustedIPs:
        - {{ index $wgPublic.peers $wgPublic.hub }}
    transport:
      respondingTimeouts:
        readTimeout: 0
  # VPN users, only reachable by the VPS over the wg-backbone WireGuard network
  wg-private:
    port: 8445
    nodePort: {{ .Values.traefik_private_nodeport }}
    expose:
      default: false
      wg-private: true
    http:
      tls:
        enabled: true
    # The VPS proxy passes the VPN user's address
    proxyProtocol:
      trustedIPs:
        - {{ index $wgBackbone.peers $wgBackbone.hub }}
    transport:
      respondingTimeouts:
        readTimeout: 0

ingressRoute:
  dashboard:
    enabled: true
    entryPoints: [lan-https]
    matchRule: Host(`{{ $host }}`)
    middlewares:
      - name: authentik-forward-auth@file

tlsStore:
  default:
    defaultCertificate:
      secretName: wildcard-crfda-tls

tlsOptions:
  default:
    minVersion: VersionTLS12

additionalArguments:
  - "--providers.file.directory=/dynamic"
  - "--providers.file.watch=true"
  - "--log.level=WARN"
  - "--accesslog=true"
