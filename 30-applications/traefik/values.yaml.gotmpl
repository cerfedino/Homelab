service:
  type: LoadBalancer
  annotations:
    # prettier-ignore
    kube-vip.io/loadbalancerIPs: {{ .Values.kube_vip_svc_address | quote }}
  additionalServices:
    cloudflared:
      type: ClusterIP

deployment:
  replicas: 3
  # External dynamic traefik config
  additionalVolumes:
    - name: dynamic
      configMap:
        name: traefik-dynamic
        optional: true # don't block pod start while the CM doesn't exist yet

podDisruptionBudget:
  enabled: true
  minAvailable: 1

topologySpreadConstraints:
  - labelSelector:
      matchLabels:
        app.kubernetes.io/name: traefik
    maxSkew: 1
    topologyKey: kubernetes.io/hostname
    whenUnsatisfiable: ScheduleAnyway

additionalVolumeMounts:
  - name: dynamic
    mountPath: /dynamic
    readOnly: true

providers:
  kubernetesCRD:
    enabled: true # IngressRoutes for in-cluster apps
  kubernetesIngress:
    enabled: false # not using plain Ingress objects
  kubernetesGateway:
    enabled: false # no Gateway API (IngressRoute only)

gateway:
  enabled: false
gatewayClass:
  enabled: false

# entrypoints
ports:
  web:
    port: 8000
    exposedPort: 80
  websecure:
    port: 8443
    exposedPort: 443
    transport:
      respondingTimeouts:
        readTimeout: 0
  cloudflared:
    port: 8444
    expose:
      default: false
      cloudflared: true
    http:
      tls:
        enabled: true
    forwardedHeaders:
      # trust any pod is fine because we are restricting it to just cloudflared with the traefik NetworkPolicy
      trustedIPs:
        - {{ .Values.k3s_cluster_cidr }}
    transport:
      respondingTimeouts:
        readTimeout: 0

ingressRoute:
  dashboard:
    enabled: true
    entryPoints:
      - websecure
    matchRule: Host(`{{ .Values.apps.traefik.internal.dns_hostname }}`)
    middlewares:
{{- if eq .Values.apps.traefik.internal.type "forward-auth" }}
      - name: authentik-forward-auth-local@file
{{- end }}

tlsStore:
  default:
    defaultCertificate:
      secretName: wildcard-crfda-tls

tlsOptions:
  default:
    minVersion: VersionTLS12

additionalArguments:
  - "--providers.file.directory=/dynamic"
  - "--providers.file.watch=true"
  - "--entrypoints.websecure.http.tls=true"
  - "--log.level=WARN"
  - "--accesslog=true"

extraObjects:
{{- range $f := readDirEntries "extras" }}
{{- if not (hasPrefix "." $f.Name) }}
{{- range $doc := splitList "\n---\n" (tpl (readFile (printf "extras/%s" $f.Name)) $) }}
  - {{ $doc | fromYaml | toYaml | nindent 4 | trim }}
{{- end }}
{{- end }}
{{- end }}
