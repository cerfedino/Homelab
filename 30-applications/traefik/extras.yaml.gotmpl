{{- $wgPublic := index .Values.wireguard "wg-public" }}
{{- $wgPrivate := index .Values.wireguard "wg-private" }}
{{- $pve1 := readFile "app-pve1.enc.yaml" | fromYaml }}
{{- $pbs1 := readFile "app-pbs1.enc.yaml" | fromYaml }}
{{- $haos := readFile "app-haos.enc.yaml" | fromYaml }}
{{- $wgportal := readFile "../vps/wg-portal/app.enc.yaml" | fromYaml }}
configMaps:
  dynamic:
    forceRename: traefik-dynamic
    data:
      external-hosts.yaml: |
        http:
          serversTransports:
            insecure-backends:
              insecureSkipVerify: true

          middlewares:
            authentik-forward-auth:
              forwardAuth:
                address: http://ak-outpost-external.authentik.svc.cluster.local:9000/outpost.goauthentik.io/auth/traefik
                trustForwardHeader: true
                authResponseHeaders:
                  - X-authentik-username
                  - X-authentik-groups
                  - X-authentik-entitlements
                  - X-authentik-email
                  - X-authentik-name
                  - X-authentik-uid
                  - X-authentik-jwt
                  - X-authentik-meta-jwks
                  - X-authentik-meta-outpost
                  - X-authentik-meta-provider
                  - X-authentik-meta-app
                  - X-authentik-meta-version

          routers:
            pve1:
              rule: Host(`{{ index $pve1.hosts 0 }}`)
              entryPoints: [lan-https]
              middlewares:
                - authentik-forward-auth
              service: pve1
            pbs1:
              rule: Host(`{{ index $pbs1.hosts 0 }}`)
              entryPoints: [lan-https]
              middlewares:
                - authentik-forward-auth
              service: pbs1
            haos:
              rule: Host(`{{ index $haos.hosts 0 }}`)
              entryPoints: [lan-https]
              service: haos
            wg-portal:
              rule: Host(`{{ index $wgportal.hosts 0 }}`)
              entryPoints: [wg-private]
              service: wg-portal

          services:
            # The VPN enrollment page on the VPS, over the wg-private WireGuard network. Its route lists wg-private only
            wg-portal:
              loadBalancer:
                servers:
                  - url: "http://{{ index $wgPrivate.peers $wgPrivate.hub }}:8888"
            pve1:
              loadBalancer:
                servers:
                  - url: "https://{{ .Values.machines.pve1.fqdn_internal }}:8006"
            pbs1:
              loadBalancer:
                servers:
                  - url: "https://pbs1.internal.crfda.com:8007"
            haos:
              loadBalancer:
                servers:
                  - url: "http://{{ .Values.machines.haos.fqdn_internal }}:8123"

networkpolicies:
  namespace:
    forceRename: namespace-ingress
    podSelector: {}
    policyTypes: [Ingress]
    rules:
      ingress:
        # Same namespace
        - from:
            - podSelector: {}

        # lan-http and lan-https entrypoints: LAN clients, kuma's monitors, and pods that call apps by hostname (OIDC against authentik, nextcloud and collabora)
        - from:
            - ipBlock:
                cidr: {{ .Values.network_lan_cidr }}
            - namespaceSelector:
                matchExpressions:
                  - key: kubernetes.io/metadata.name
                    operator: In
                    values:
                      - kuma
                      - ai
                      - immich
                      - librechat
                      - media
                      - nextcloud
                      - paperless
                      - sparkyfitness
                      - tandoor
                      - vaultwarden
                      - windmill
          ports:
            - port: 80
            - port: 443
        # wg-public entrypoint is just the VPS, over the wg-public WireGuard network
        - from:
            - ipBlock:
                cidr: {{ index $wgPublic.peers $wgPublic.hub }}/32
          ports:
            - port: 8444
        # wg-private entrypoint is just the VPS, over the wg-private WireGuard network
        - from:
            - ipBlock:
                cidr: {{ index $wgPrivate.peers $wgPrivate.hub }}/32
          ports:
            - port: 8445

rawResources:
  # wildcard certificates for the homelab
  certificate:
    forceRename: wildcard-crfda
    manifest:
      apiVersion: cert-manager.io/v1
      kind: Certificate
      spec:
        secretName: wildcard-crfda-tls
        dnsNames:
          - "*.{{ .Values.domain_lan }}"
          - "*.{{ .Values.domain }}"
          - "{{ .Values.domain }}"
        issuerRef:
          name: letsencrypt
          kind: ClusterIssuer
