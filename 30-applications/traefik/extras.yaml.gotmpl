configMaps:
  dynamic:
    forceRename: traefik-dynamic
    data:
      external-hosts.yaml: |
        http:
          serversTransports:
            insecure-backends:
              insecureSkipVerify: true

          middlewares:
            authentik-forward-auth-local:
              forwardAuth:
                # Forward to the Authentik outpost specifically responsible for applications exposed to the local network
                address: http://authentik-server.authentik.svc.cluster.local/outpost.goauthentik.io/auth/traefik
                trustForwardHeader: true
                authResponseHeaders: &authentikResponseHeaders
                  - X-authentik-username
                  - X-authentik-groups
                  - X-authentik-entitlements
                  - X-authentik-email
                  - X-authentik-name
                  - X-authentik-uid
                  - X-authentik-jwt
                  - X-authentik-meta-jwks
                  - X-authentik-meta-outpost
                  - X-authentik-meta-provider
                  - X-authentik-meta-app
                  - X-authentik-meta-version
            authentik-forward-auth-external:
              forwardAuth:
                # Forward to the Authentik outpost specifically responsible for applications exposed to the open internet
                address: http://ak-outpost-external.authentik.svc.cluster.local:9000/outpost.goauthentik.io/auth/traefik
                trustForwardHeader: true
                authResponseHeaders: *authentikResponseHeaders

          routers:
{{- range $f := tuple "app-pve1.enc.yaml" "app-pbs1.enc.yaml" "app-haos.enc.yaml" }}
{{- $app := readFile $f | fromYaml }}
{{- range $variant, $v := omit $app "name" }}
{{- if $v.dns_hostname }}
            {{ $app.name }}-{{ $variant }}:
              rule: Host(`{{ $v.dns_hostname }}`)
              entryPoints:
                #- {{ eq $variant "internal" | ternary "lan-https" "cloudflared" }}
                - lan-https
{{- if eq $v.type "forward-auth" }}
              middlewares:
                - authentik-forward-auth-{{ eq $variant "internal" | ternary "local" "external" }}
{{- end }}
              service: {{ $app.name }}
{{- end }}
{{- end }}
{{- end }}

          services:
            pve1:
              loadBalancer:
                servers:
                  - url: "https://{{ .Values.machines.pve1.fqdn_internal }}:8006"
            pbs1:
              loadBalancer:
                servers:
                  - url: "https://pbs1.internal.crfda.com:8007"
            haos:
              loadBalancer:
                servers:
                  - url: "http://{{ .Values.machines.haos.fqdn_internal }}:8123"

networkpolicies:
  namespace:
    forceRename: namespace-ingress
    podSelector: {}
    policyTypes: [Ingress]
    rules:
      ingress:
        # Same namespace
        - from:
            - podSelector: {}

        # lan-http and lan-https entrypoints: LAN clients, kuma's monitors, and pods that call apps by hostname (OIDC against authentik, nextcloud and collabora)
        - from:
            - ipBlock:
                cidr: {{ .Values.network_lan_cidr }}
            - namespaceSelector:
                matchExpressions:
                  - key: kubernetes.io/metadata.name
                    operator: In
                    values:
                      - kuma
                      - ai
                      - immich
                      - librechat
                      - media
                      - nextcloud
                      - paperless
                      - sparkyfitness
                      - tandoor
                      - vaultwarden
                      - windmill
          ports:
            - port: 80
            - port: 443

rawResources:
  # wildcard certificates for the homelab
  certificate:
    forceRename: wildcard-crfda
    manifest:
      apiVersion: cert-manager.io/v1
      kind: Certificate
      spec:
        secretName: wildcard-crfda-tls
        dnsNames:
          - "*.{{ .Values.domain_lan }}"
          - "*.{{ .Values.domain }}"
          - "{{ .Values.domain }}"
        issuerRef:
          name: letsencrypt
          kind: ClusterIssuer
