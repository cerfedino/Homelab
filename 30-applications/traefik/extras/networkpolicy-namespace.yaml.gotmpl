apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: namespace-ingress
  namespace: traefik
spec:
  podSelector: {}
  policyTypes:
    - Ingress
  ingress:
    # Same namespace
    - from:
        - podSelector: {}

    # lan-http and lan-https entrypoints: LAN clients, kuma's monitors, and pods that call apps by hostname (OIDC against authentik, nextcloud and collabora)
    - from:
        - ipBlock:
            cidr: {{ .Values.network_lan_cidr }}
        #- namespaceSelector:
        #    matchLabels:
        #      kubernetes.io/metadata.name: kuma
        - namespaceSelector:
            matchExpressions:
              - key: kubernetes.io/metadata.name
                operator: In
                values:
                  - kuma
                  - ai
                  - immich
                  - librechat
                  - media
                  - nextcloud
                  - paperless
                  - sparkyfitness
                  - tandoor
                  - vaultwarden
                  - windmill
      ports:
        - port: 80
        - port: 443

    # For the clouflared entrypoint, only cloudflared can talk to it because we trust its CF headers for the real IP
    #- from:
    #    - namespaceSelector:
    #        matchLabels:
    #          kubernetes.io/metadata.name: #cloudflare-tunnel
    #  ports:
    #    - port: 8444
