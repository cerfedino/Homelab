apiVersion: v1
kind: ConfigMap
metadata:
  name: librechat-config
data:
  librechat.yaml: |
    version: 1.3.14
    cache: true

    # seeds USER role permissions at startup: MCP use only
    interface:
      mcpServers:
        use: true
        create: false
        share: false
        public: false

    endpoints:
      custom:
        - name: LiteLLM
          apiKey: '${LITELLM_API_KEY}'
          baseURL: http://litellm.ai.svc.cluster.local:4000/v1
          models:
            default:
              - claude-sonnet-5
            fetch: true
          titleConvo: true
          titleModel: claude-code-haiku
          modelDisplayLabel: LiteLLM
          tokenConfig:
            # claude-opus-5:
            #   prompt: 5
            #   completion: 25
            #   context: 1000000
            # claude-sonnet-5:
            #   prompt: 3
            #   completion: 15
            #   context: 1000000
            # claude-haiku-4-5:
            #   prompt: 1
            #   completion: 5
            #   context: 200000
            claude-code-fable:
              prompt: 10
              completion: 50
              context: 1000000
            claude-code-opus:
              prompt: 5
              completion: 25
              context: 1000000
            claude-code-opus-4-8:
              prompt: 5
              completion: 25
              context: 1000000
            claude-code-opus-4-7:
              prompt: 5
              completion: 25
              context: 1000000
            claude-code-opus-4-6:
              prompt: 5
              completion: 25
              context: 1000000
            claude-code-sonnet:
              prompt: 3
              completion: 15
              context: 1000000
            claude-code-sonnet-4-6:
              prompt: 3
              completion: 15
              context: 1000000
            claude-code-haiku:
              prompt: 1
              completion: 5
              context: 200000

    memory:
      disabled: false
      personalize: true
      validKeys: [preferences, work_info, personal_info, skills, interests, context]
      tokenLimit: 10000
      messageWindowSize: 10
      agent:
        enabled: true
        provider: LiteLLM
        model: claude-code-haiku

    mcpSettings:
      allowedAddresses:
        - "nextcloud-mcp.ai.svc.cluster.local:8000"


    mcpServers:
      nextcloud:
        type: streamable-http
        url: http://nextcloud-mcp.ai.svc.cluster.local:8000/mcp
        headers:
          X-Nextcloud-Username: '{{"{{"}}NEXTCLOUD_USERNAME{{"}}"}}'
          X-Nextcloud-AppToken: '{{"{{"}}NEXTCLOUD_APPTOKEN{{"}}"}}'
        customUserVars:
          NEXTCLOUD_USERNAME:
            title: Nextcloud username
            description: Your Nextcloud login name
            sensitive: false
          NEXTCLOUD_APPTOKEN:
            title: Nextcloud app token
            description: Generate under Settings → Security → Devices & sessions
            sensitive: true
        startup: true
      hevy:
        type: stdio
        command: npx
        args:
          - -y
          - 'hevy-mcp@6.1.19'
        env:
          HEVY_API_KEY: '{{"{{"}}HEVY_API_KEY{{"}}"}}'
        customUserVars:
          HEVY_API_KEY:
            title: Hevy API Key
            description: Get API key at https://hevy.com/settings?developer
            sensitive: true
        startup: true
      yazio:
        type: stdio
        command: npx
        args:
          - -y
          - 'yazio-mcp@0.0.14'
        env:
          YAZIO_USERNAME: '{{"{{"}}YAZIO_USERNAME{{"}}"}}'
          YAZIO_PASSWORD: '{{"{{"}}YAZIO_PASSWORD{{"}}"}}'
        customUserVars:
          YAZIO_USERNAME:
            title: Username
            description: Your YAZIO username
            sensitive: false
          YAZIO_PASSWORD:
            title: Password
            description: Your YAZIO password
            sensitive: true
        startup: true
        startup: false
