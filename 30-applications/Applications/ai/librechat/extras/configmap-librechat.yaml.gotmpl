apiVersion: v1
kind: ConfigMap
metadata:
  name: librechat-config
data:
  librechat.yaml: |
    version: 1.3.14
    cache: true

    # seeds USER role permissions at startup: MCP use only
    interface:
      mcpServers:
        use: true
        create: false
        share: false
        public: false

    endpoints:
      agents:
        recursionLimit: 1000
      custom:
        - name: LiteLLM
          apiKey: '${LITELLM_API_KEY}'
          baseURL: http://litellm.ai.svc.cluster.local:4000/v1
          models:
            default:
              - claude-sonnet-5
            fetch: true
          titleConvo: true
          titleModel: claude-code-haiku
          modelDisplayLabel: LiteLLM
          tokenConfig:
            # claude-opus-5:
            #   prompt: 5
            #   completion: 25
            #   context: 1000000
            # claude-sonnet-5:
            #   prompt: 3
            #   completion: 15
            #   context: 1000000
            # claude-haiku-4-5:
            #   prompt: 1
            #   completion: 5
            #   context: 200000
            claude-code-fable:
              prompt: 10
              completion: 50
              context: 1000000
            claude-code-opus:
              prompt: 5
              completion: 25
              context: 1000000
            claude-code-opus-4-8:
              prompt: 5
              completion: 25
              context: 1000000
            claude-code-opus-4-7:
              prompt: 5
              completion: 25
              context: 1000000
            claude-code-opus-4-6:
              prompt: 5
              completion: 25
              context: 1000000
            claude-code-sonnet:
              prompt: 3
              completion: 15
              context: 1000000
            claude-code-sonnet-4-6:
              prompt: 3
              completion: 15
              context: 1000000
            claude-code-haiku:
              prompt: 1
              completion: 5
              context: 200000

    memory:
      disabled: false
      personalize: true
      validKeys: [preferences, work_info, personal_info, skills, interests, context]
      tokenLimit: 10000
      messageWindowSize: 10
      agent:
        enabled: true
        provider: LiteLLM
        model: claude-code-haiku

    mcpSettings:
      allowedAddresses:
        - "nextcloud-mcp.ai.svc.cluster.local:8000"
        - "sparkyfitness-server.sparkyfitness.svc.cluster.local:3010"


    mcpServers:
      nextcloud:
        type: streamable-http
        url: http://nextcloud-mcp.ai.svc.cluster.local:8000/mcp
        headers:
          X-Nextcloud-Username: '{{"{{"}}NEXTCLOUD_USERNAME{{"}}"}}'
          X-Nextcloud-AppToken: '{{"{{"}}NEXTCLOUD_APPTOKEN{{"}}"}}'
        customUserVars:
          NEXTCLOUD_USERNAME:
            title: Nextcloud username
            description: Your Nextcloud login name
            sensitive: false
          NEXTCLOUD_APPTOKEN:
            title: Nextcloud app token
            description: Generate under Settings → Security → Devices & sessions
            sensitive: true
        startup: true
      hevy:
        type: stdio
        command: npx
        args:
          - -y
          - 'hevy-mcp@6.1.19'
        env:
          HEVY_API_KEY: '{{"{{"}}HEVY_API_KEY{{"}}"}}'
        customUserVars:
          HEVY_API_KEY:
            title: Hevy API Key
            description: Get API key at https://hevy.com/settings?developer
            sensitive: true
        startup: true
      yazio:
        type: stdio
        command: npx
        args:
          - -y
          - 'yazio-mcp@0.0.14'
        env:
          YAZIO_USERNAME: '{{"{{"}}YAZIO_USERNAME{{"}}"}}'
          YAZIO_PASSWORD: '{{"{{"}}YAZIO_PASSWORD{{"}}"}}'
        customUserVars:
          YAZIO_USERNAME:
            title: Username
            description: Your YAZIO username
            sensitive: false
          YAZIO_PASSWORD:
            title: Password
            description: Your YAZIO password
            sensitive: true
        startup: true
      migros:
        type: stdio
        command: npx
        args:
          - -y
          - 'migros-mcp@0.3.1'
        env:
          MIGROS_EMAIL: '{{"{{"}}MIGROS_EMAIL{{"}}"}}'
          MIGROS_PASSWORD: '{{"{{"}}MIGROS_PASSWORD{{"}}"}}'
          MIGROS_TOTP_SECRET: '{{"{{"}}MIGROS_TOTP_SECRET{{"}}"}}'
        customUserVars:
          MIGROS_EMAIL:
            title: MIGROS Email
            description: Your MIGROS email
            sensitive: false
          MIGROS_PASSWORD:
            title: MIGROS Password
            description: Your MIGROS password
            sensitive: true
          MIGROS_TOTP_SECRET:
            title: MIGROS TOTP Secret
            description: Your MIGROS TOTP secret
            sensitive: true
        startup: false
      tandoor:
        type: stdio
        command: npx
        args:
          - -y
          - '@cliftonz/tandoor-recipes-mcp@2.0.1'
        env:
          TANDOOR_URL: http://tandoor.tandoor.svc.cluster.local
          TANDOOR_TOKEN: '{{"{{"}}TANDOOR_TOKEN{{"}}"}}'
          TANDOOR_MCP_PROFILE: full
          TANDOOR_MCP_INCLUDE_ONLY: >-
            get_version, get_guard_stats, jq_query, jq_stash_stats,
            list_recipes, list_recipes_flat, get_recipe, search_recipes, related_recipes,
            list_meal_plans, get_meal_plan, list_meal_types, list_shopping_entries,
            list_foods, get_food, list_ingredients, parse_ingredient,
            list_keywords, get_keyword, get_current_space,
            create_recipe, update_recipe, delete_recipe, delete_recipe_external,
            import_recipe_from_url, upload_recipe_image, add_recipe_to_shopping_list,
            recipe_batch_update,
            merge_unit, list_property_types, create_property_type,
            create_property, update_property, update_food, food_fdc_lookup,
            export_recipes, list_export_logs, get_export_log, create_export_log,
            update_export_log, delete_export_log, import_recipes,
            create_import_log, get_import_log, update_import_log, delete_import_log,
            list_open_data_imports, run_open_data_import,
            list_recipe_imports, create_recipe_import, get_recipe_import,
            update_recipe_import, delete_recipe_import,
            import_all_pending, import_pending_recipe,
            list_bookmarklet_imports, create_bookmarklet_import, get_bookmarklet_import,
            update_bookmarklet_import, delete_bookmarklet_import,
            fdc_search, list_food_inherit_fields, get_food_inherit_field,
            delete_food, merge_food, move_food,
            preview_food_delete_cascading, preview_food_delete_nulling, preview_food_delete_protecting,
            get_ingredient, create_ingredient, update_ingredient, delete_ingredient,
            list_ai_providers, get_ai_provider, create_ai_provider, update_ai_provider,
            import_recipe_from_image, ai_step_sort,
            create_meal_plan, update_meal_plan, delete_meal_plan,
            bulk_create_meal_plans, auto_meal_plan, create_meal_type,
            create_shopping_entry, update_shopping_entry, delete_shopping_entry,
            bulk_check_shopping_entries, list_shopping_list_recipes,
            create_shopping_list_recipe, update_shopping_list_recipe, delete_shopping_list_recipe,
            list_supermarket_categories, create_supermarket_category, update_supermarket_category,
            create_supermarket_category_relation,
            create_unit, update_unit, create_unit_conversion, update_unit_conversion,
            create_keyword, merge_keyword, move_keyword
        customUserVars:
          TANDOOR_TOKEN:
            title: Tandoor API Token
            description: Create under Settings → API Tokens in Tandoor
            sensitive: true
        startup: true

      sparkyfitness:
        type: streamable-http
        requiresOAuth: false
        url: http://sparkyfitness-server.sparkyfitness.svc.cluster.local:3010/mcp
        headers:
          Authorization: '{{"Bearer {{"}}API_KEY{{"}}"}}'
        customUserVars:
          API_KEY:
            title: SparkyFitness API KEY
            description: Generate under Settings → Developer & Integrations → API Key Management
            sensitive: true
        startup: true
