{{- $app := readFile "app.enc.yaml" | fromYaml }}
{{- $host := index $app.hosts 0 }}
controllers:
  vaultwarden:
    pod:
      annotations:
        k8up.io/backupcommand: sh -c 'sqlite3 /data/db.sqlite3 .dump'
        k8up.io/file-extension: .sql
    containers:
      sqlite:
        image:
          repository: keinos/sqlite3
          tag: 3.53.4
        command: ["sleep", "infinity"]
        resources:
          limits:
            memory: 64Mi
      app:
        nameOverride: vaultwarden
        image:
          repository: vaultwarden/server
          tag: 1.37.4
        env:
          - name: DOMAIN
            value: https://{{ $host }}
          - name: IP_HEADER
            value: X-Forwarded-For
          - name: SIGNUPS_ALLOWED
            value: "false"
          # SSO logins from this domain create accounts
          - name: SIGNUPS_DOMAINS_WHITELIST
            value: {{ .Values.domain | quote }}
          - name: SIGNUPS_VERIFY
            value: "true"
          - name: SMTP_HOST
            value: {{ .Values.smtp.host | quote }}
          - name: SMTP_PORT
            value: {{ .Values.smtp.port | quote }}
          - name: SMTP_SECURITY
            value: {{ .Values.smtp.security | quote }}
          - name: SMTP_USERNAME
            value: {{ .Values.smtp.username | quote }}
          - name: SMTP_FROM
            value: {{ .Values.smtp.from | quote }}
          - name: SMTP_FROM_NAME
            value: Vaultwarden
          - name: SMTP_PASSWORD
            valueFrom:
              secretKeyRef:
                name: vaultwarden-smtp
                key: password
          - name: INVITATIONS_ALLOWED
            value: "false"
          # no ADMIN_TOKEN: the /admin panel stays disabled entirely
          - name: SSO_ENABLED
            value: "true"
          - name: SSO_ONLY
            value: "true"
          - name: SSO_AUTHORITY
            value: {{ $app.authentik.oidc.issuer | quote }}
          - name: SSO_CLIENT_ID
            value: {{ $app.authentik.oidc.client_id | quote }}
          - name: SSO_CLIENT_SECRET
            valueFrom:
              secretKeyRef:
                name: vaultwarden-sso
                key: client_secret
          - name: SSO_SCOPES
            value: "email profile offline_access"
        ports:
          - containerPort: 80
        probes:
          readiness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /alive
                port: 80
              initialDelaySeconds: 10
        resources:
          limits:
            memory: 512Mi

service:
  app:
    controller: vaultwarden
    ports:
      http:
        port: 80

secrets:
  smtp:
    stringData:
      password: {{ .Values.smtp.password | quote }}
  sso:
    stringData:
      client_secret: {{ $app.authentik.oidc.client_secret | quote }}

persistence:
  data:
    forceRename: vaultwarden-data
    type: persistentVolumeClaim
    accessMode: ReadWriteOnce
    storageClass: proxmox-data-zfs
    size: 2Gi
    annotations:
      helm.sh/resource-policy: keep
    globalMounts:
      - path: /data

networkpolicies:
  namespace:
    podSelector: {}
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - podSelector: {}
  traefik:
    controller: vaultwarden
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: traefik

rawResources:
  vaultwarden:
    manifest:
      apiVersion: traefik.io/v1alpha1
      kind: IngressRoute
      spec:
        entryPoints: [lan-https, wg-trusted]
        routes:
          - match: Host(`{{ $host }}`)
            kind: Rule
            services:
              - name: vaultwarden
                port: 80
  backup:
    forceRename: backup
    manifest:
      apiVersion: k8up.io/v1
      kind: Schedule
      spec: {{ (tpl (readFile "../../_lib/schedule.yaml.gotmpl") (dict "bucket" "vaultwarden" "Values" .Values) | fromYaml).spec | toYaml | nindent 8 }}
