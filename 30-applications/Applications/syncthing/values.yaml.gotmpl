{{- $app := readFile "app.enc.yaml" | fromYaml }}
{{- $host := index $app.hosts 0 }}
controllers:
  syncthing:
    containers:
      app:
        image:
          repository: syncthing/syncthing
          tag: 2.1.6
        ports:
          - name: gui
            containerPort: 8384
          - name: sync-tcp
            containerPort: 22000
            protocol: TCP
          - name: sync-udp
            containerPort: 22000
            protocol: UDP
        probes:
          readiness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /rest/noauth/health
                port: 8384
              initialDelaySeconds: 10
        resources:
          limits:
            memory: 1Gi

service:
  web:
    forceRename: syncthing-web
    controller: syncthing
    ports:
      http:
        port: 8384

persistence:
  data:
    forceRename: syncthing-data
    type: persistentVolumeClaim
    accessMode: ReadWriteOnce
    storageClass: proxmox-data-zfs
    size: 50Gi
    annotations:
      helm.sh/resource-policy: keep
    globalMounts:
      - path: /var/syncthing

networkpolicies:
  namespace:
    podSelector: {}
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - podSelector: {}
  traefik:
    controller: syncthing
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: traefik

rawResources:
  syncthing:
    forceRename: syncthing
    manifest:
      apiVersion: traefik.io/v1alpha1
      kind: IngressRoute
      spec:
        entryPoints: [lan-https]
        routes:
          - match: Host(`{{ $host }}`)
            kind: Rule
            middlewares:
              - name: authentik-forward-auth@file
            services:
              - name: syncthing-web
                port: 8384
  backup:
    forceRename: backup
    manifest:
      apiVersion: k8up.io/v1
      kind: Schedule
      spec: {{ (tpl (readFile "../../_lib/schedule.yaml.gotmpl") (dict "bucket" "syncthing" "Values" .Values) | fromYaml).spec | toYaml | nindent 8 }}
