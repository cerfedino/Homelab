{{- $first := true }}
{{- range $variant, $v := .Values.apps.filecloud }}
{{- if $v.dns_hostname }}
{{- if not $first }}
---
{{- end }}
{{- $first = false }}
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: nextcloud-{{ $variant }}
spec:
  entryPoints:
    - {{ eq $variant "internal" | ternary "lan-https" "cloudflared" }}
  routes:
    - match: Host(`{{ $v.dns_hostname }}`)
      kind: Rule
      priority: 10
      middlewares:
        - name: nextcloud-hsts
{{- if eq $v.type "forward-auth" }}
        - name: authentik-forward-auth-{{ eq $variant "internal" | ternary "local" "external" }}@file
{{- end }}
      services:
        - name: nextcloud
          port: 8080
    # Collabora is under the same hostname
    - match: Host(`{{ $v.dns_hostname }}`) && (PathPrefix(`/browser`) || PathPrefix(`/hosting/discovery`) || PathPrefix(`/hosting/capabilities`) || PathPrefix(`/cool`))
      kind: Rule
      priority: 20
      services:
        - name: nextcloud-collabora
          port: 9980
    # notify_push sidecar
    - match: Host(`{{ $v.dns_hostname }}`) && PathPrefix(`/push`)
      kind: Rule
      priority: 20
      services:
        - name: nextcloud-push
          port: 7867
      middlewares:
        - name: push-stripprefix
    # Also whiteboard
    - match: Host(`{{ $v.dns_hostname }}`) && PathPrefix(`/whiteboard`)
      kind: Rule
      priority: 20
      services:
        - name: nextcloud-whiteboard
          port: 3002
      middlewares:
        - name: whiteboard-stripprefix
{{- end }}
{{- end }}
