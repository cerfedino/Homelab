{{- $secrets := fromYaml (readFile "values.enc.yaml") }}
# renovate: datasource=docker depName=nextcloud
{{- $ncTag := "35.0.1-apache" }}

image:
  tag: {{ $ncTag }}

nextcloud:
  host: {{ .Values.apps.filecloud.external.dns_hostname }}
  username: admin
  password: {{ $secrets.nextcloud_admin_password | quote }}

  mail:
    enabled: true
    # the chart wants the from-address split into local part and domain
    fromAddress: {{ (split "@" .Values.smtp.from)._0 | quote }}
    domain: {{ (split "@" .Values.smtp.from)._1 | quote }}
    smtp:
      host: {{ .Values.smtp.host }}
      port: {{ .Values.smtp.port }}
      secure: {{ .Values.smtp.security }}
      name: {{ .Values.smtp.username }}
      password: {{ .Values.smtp.password | quote }}

  configs:
    custom.config.php: |-
      <?php
      $CONFIG = array(
        'trusted_domains' => array('localhost', 'nextcloud', 'nextcloud.nextcloud.svc.cluster.local', '{{ .Values.apps.filecloud.external.dns_hostname }}'),
        'overwrite.cli.url' => 'https://{{ .Values.apps.filecloud.external.dns_hostname }}',
        'overwriteprotocol' => 'https',
        'default_phone_region' => 'CH',
        'maintenance_window_start' => 1,
        // trust the pod network such that we can read the X-Forwarded-For IP
        'trusted_proxies' => array('{{ .Values.k3s_cluster_cidr }}'),
        // imaginary offloads image preview generation (chart service, port 80)
        'preview_imaginary_url' => 'http://nextcloud-imaginary/',
        'enabledPreviewProviders' => array(
          'OC\Preview\MP3',
          'OC\Preview\TXT',
          'OC\Preview\MarkDown',
          'OC\Preview\OpenDocument',
          'OC\Preview\Imaginary',
        ),
      );

  phpConfigs:
    uploadLimit.ini: |
      upload_max_filesize = 16G
      post_max_size = 16G
      max_input_time = 3600
      max_execution_time = 3600
      memory_limit = 1G

  extraEnv:
    - name: WHITEBOARD_URL
      value: https://{{ .Values.apps.filecloud.external.dns_hostname }}/whiteboard
    - name: WHITEBOARD_JWT_SECRET
      valueFrom:
        secretKeyRef:
          name: nextcloud-whiteboard
          key: jwt_secret
    - name: COLLABORA_WOPI_URL
      value: https://{{ .Values.apps.filecloud.external.dns_hostname }}
    - name: OIDC_CLIENT_ID
      valueFrom:
        secretKeyRef:
          name: nextcloud-oidc
          key: client_id
    - name: OIDC_CLIENT_SECRET
      valueFrom:
        secretKeyRef:
          name: nextcloud-oidc
          key: client_secret
    - name: OIDC_DISCOVERY_URI
      valueFrom:
        secretKeyRef:
          name: nextcloud-oidc
          key: discovery_uri

  # the push binary ships inside the notify_push app on the shared PVC
  extraSidecarContainers:
    - name: notify-push
      image: nextcloud:{{ $ncTag }}
      command:
        - /var/www/html/custom_apps/notify_push/bin/x86_64/notify_push
        - --database-url
        - postgres://oc_nextcloud:{{ $secrets.nextcloud_postgres_password }}@nextcloud-postgres/nextcloud_database
        - --redis-url
        - redis://nextcloud-redis
        - --nextcloud-url
        - http://nextcloud:8080
        - --bind
        - 0.0.0.0
      ports:
        - containerPort: 7867
      volumeMounts:
        - name: nextcloud-main
          mountPath: /var/www/html
          subPath: html
        - name: nextcloud-main
          mountPath: /var/www/html/custom_apps
          subPath: custom_apps
      resources:
        requests:
          memory: 32Mi
        limits:
          memory: "128Mi"

internalDatabase:
  enabled: false

externalDatabase:
  enabled: true
  type: postgresql
  host: nextcloud-postgres
  database: nextcloud_database
  user: oc_nextcloud
  password: {{ $secrets.nextcloud_postgres_password | quote }}

postgresql:
  enabled: false
mariadb:
  enabled: false
redis:
  enabled: false

externalRedis:
  enabled: true
  host: nextcloud-redis

cronjob:
  enabled: true

collabora:
  enabled: true
  collabora:
    # Collabora is under the same hostname
    server_name: {{ .Values.apps.filecloud.external.dns_hostname }}
    aliasgroups:
      - host: "https://{{ .Values.apps.filecloud.external.dns_hostname }}:443"
    username: admin
    password: {{ $secrets.collabora_admin_password | quote }}
    # TLS terminates at traefik
    extra_params: --o:ssl.enable=false --o:ssl.termination=true
  resources:
    requests:
      memory: 512Mi
    limits:
      memory: "2Gi"

imaginary:
  enabled: true
  resources:
    requests:
      memory: 64Mi
    limits:
      memory: "1G"

resources:
  requests:
    memory: 512Mi
  limits:
    memory: "3Gi"

persistence:
  enabled: true
  existingClaim: nextcloud-data

extraManifests:
{{- range $f := readDirEntries "extras" }}
{{- if not (hasPrefix "." $f.Name) }}
{{- range $doc := splitList "\n---\n" (tpl (readFile (printf "extras/%s" $f.Name)) $) }}
  - {{ $doc | fromYaml | toYaml | nindent 4 | trim }}
{{- end }}
{{- end }}
{{- end }}
