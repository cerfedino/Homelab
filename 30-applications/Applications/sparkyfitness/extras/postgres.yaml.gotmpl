apiVersion: apps/v1
kind: Deployment
metadata:
  name: sparkyfitness-postgres
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: sparkyfitness-postgres
  template:
    metadata:
      labels:
        app: sparkyfitness-postgres
      annotations:
        k8up.io/backupcommand: sh -c 'PGPASSWORD="$POSTGRES_PASSWORD" pg_dumpall --clean -U "$POSTGRES_USER"'
        k8up.io/file-extension: .sql
    spec:
      containers:
        - name: postgres
          image: postgres:18.6
          env:
            # subdirectory: initdb refuses the mount point itself (lost+found)
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
            - name: POSTGRES_USER
              value: sparkyfitness
            - name: POSTGRES_DB
              value: sparkyfitness
            - name: POSTGRES_INITDB_ARGS
              value: "--data-checksums"
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: sparkyfitness-postgres
                  key: password
          ports:
            - containerPort: 5432
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
          resources:
            requests:
              memory: 128Mi
            limits:
              memory: "512Mi"
          readinessProbe:
            exec:
              command: ["pg_isready", "-U", "sparkyfitness", "-d", "sparkyfitness"]
            initialDelaySeconds: 10
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: sparkyfitness-postgres-data
