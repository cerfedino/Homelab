{{- $app := readFile "app.enc.yaml" | fromYaml }}
{{- $host := index $app.hosts 0 }}
{{- $secrets := readFile "secrets.enc.yaml" | fromYaml }}
controllers:
  postgres:
    forceRename: windmill-postgres
    pod:
      annotations:
        k8up.io/backupcommand: sh -c 'PGPASSWORD="$POSTGRES_PASSWORD" pg_dumpall --clean -U "$POSTGRES_USER"'
        k8up.io/file-extension: .sql
    containers:
      app:
        image:
          repository: postgres
          tag: "18.6"
        env:
          # subdirectory: initdb refuses the mount point itself (lost+found)
          - name: PGDATA
            value: /var/lib/postgresql/data/pgdata
          - name: POSTGRES_USER
            value: windmill
          - name: POSTGRES_DB
            value: windmill
          - name: POSTGRES_INITDB_ARGS
            value: "--data-checksums"
          - name: POSTGRES_PASSWORD
            valueFrom:
              secretKeyRef:
                name: windmill-postgres
                key: password
        ports:
          - containerPort: 5432
        probes:
          readiness:
            enabled: true
            custom: true
            spec:
              exec:
                command: ["pg_isready", "-U", "windmill", "-d", "windmill"]
              initialDelaySeconds: 10
        resources:
          requests:
            memory: 256Mi
          limits:
            memory: 1Gi

service:
  postgres:
    forceRename: windmill-postgres
    controller: postgres
    ports:
      postgres:
        port: 5432

persistence:
  postgres-data:
    forceRename: windmill-postgres-data
    type: persistentVolumeClaim
    accessMode: ReadWriteOnce
    storageClass: proxmox-data-zfs
    size: 10Gi
    annotations:
      helm.sh/resource-policy: keep
      # the pod's backupcommand dump covers it
      k8up.io/backup: "false"
    advancedMounts:
      postgres:
        app:
          - path: /var/lib/postgresql/data

secrets:
  database:
    forceRename: windmill-database
    stringData:
      url: postgres://windmill:{{ $secrets.windmill_postgres_password }}@windmill-postgres/windmill?sslmode=disable
  postgres:
    forceRename: windmill-postgres
    stringData:
      password: {{ $secrets.windmill_postgres_password | quote }}

networkpolicies:
  namespace:
    podSelector: {}
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - podSelector: {}
  traefik:
    # the windmill chart's app pods, deployed by the windmill release
    podSelector:
      matchExpressions:
        - key: app.kubernetes.io/name
          operator: In
          values:
            - windmill-app
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: traefik

rawResources:
  windmill:
    forceRename: windmill
    manifest:
      apiVersion: traefik.io/v1alpha1
      kind: IngressRoute
      spec:
        entryPoints: [lan-https]
        routes:
          - match: Host(`{{ $host }}`)
            kind: Rule
            services:
              - name: windmill-app
                port: 8000
  backup:
    forceRename: backup
    manifest:
      apiVersion: k8up.io/v1
      kind: Schedule
      spec: {{ (tpl (readFile "../../_lib/schedule.yaml.gotmpl") (dict "bucket" "windmill" "Values" .Values) | fromYaml).spec | toYaml | nindent 8 }}
