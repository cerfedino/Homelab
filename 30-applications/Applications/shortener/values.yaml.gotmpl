{{- $app := readFile "app.enc.yaml" | fromYaml }}
{{- $host := index $app.hosts 0 }}
{{- $secrets := readFile "secrets.enc.yaml" | fromYaml }}
controllers:
  shortener:
    pod:
      annotations:
        k8up.io/backupcommand: sh -c 'sqlite3 /data/urls.sqlite .dump'
        k8up.io/file-extension: .sql
    containers:
      sqlite:
        image:
          repository: keinos/sqlite3
          tag: 3.53.4
        command: ["sleep", "infinity"]
        resources:
          limits:
            memory: 64Mi
      chhoto:
        image:
          repository: sintan1729/chhoto-url
          tag: 7.5.5
        env:
          - name: CHHOTO_DB_URL
            value: /data/urls.sqlite
          - name: CHHOTO_SQLITE_USE_WAL_MODE
            value: "True"
          - name: CHHOTO_SITE_URL
            value: https://{{ $host }}
          - name: CHHOTO_REDIRECT_METHOD
            value: TEMPORARY
          - name: CHHOTO_PASSWORD
            valueFrom:
              secretKeyRef:
                name: shortener
                key: password
          - name: CHHOTO_API_KEY
            valueFrom:
              secretKeyRef:
                name: shortener
                key: api_key
        ports:
          - containerPort: 4567
        probes:
          readiness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /
                port: 4567
              initialDelaySeconds: 5
        resources:
          requests:
            memory: 32Mi
          limits:
            memory: 256Mi

service:
  app:
    forceRename: shortener
    controller: shortener
    ports:
      http:
        port: 4567

secrets:
  app:
    forceRename: shortener
    stringData:
      password: {{ $secrets.chhoto_password | quote }}
      api_key: {{ $secrets.chhoto_api_key | quote }}

persistence:
  data:
    forceRename: shortener-data
    type: persistentVolumeClaim
    accessMode: ReadWriteOnce
    storageClass: proxmox-data-zfs
    size: 1Gi
    annotations:
      helm.sh/resource-policy: keep
    globalMounts:
      - path: /data

networkpolicies:
  namespace:
    podSelector: {}
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - podSelector: {}
  traefik:
    controller: shortener
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: traefik

rawResources:
  shortener:
    forceRename: shortener
    manifest:
      apiVersion: traefik.io/v1alpha1
      kind: IngressRoute
      spec:
        entryPoints: [lan-https]
        routes:
          - match: Host(`{{ $host }}`)
            kind: Rule
            services:
              - name: shortener
                port: 4567
  backup:
    forceRename: backup
    manifest:
      apiVersion: k8up.io/v1
      kind: Schedule
      spec: {{ (tpl (readFile "../../_lib/schedule.yaml.gotmpl") (dict "bucket" "shortener" "Values" .Values) | fromYaml).spec | toYaml | nindent 8 }}
