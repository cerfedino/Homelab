#!/usr/bin/env bash
# One-shot: seed chhoto with the links from the old marvin shortener.
# Reads the API key from values.enc.yaml (must be sops-open). Re-runnable:
# existing shortlinks are rejected by chhoto and reported, not overwritten.
set -euo pipefail
cd "$(dirname "$0")"

HOST="https://s.crfda.com"
API_KEY=$(awk '/chhoto_api_key/ {print $2}' values.enc.yaml | tr -d '"')

while IFS='|' read -r short long; do
  [ -z "$short" ] && continue
  code=$(curl -s -o /tmp/seed-out -w '%{http_code}' -X POST "$HOST/api/new" \
    -H "X-API-Key: $API_KEY" -H 'Content-Type: application/json' \
    -d "{\"shortlink\": \"$short\", \"longlink\": \"$long\"}")
  echo "$short -> $code $(cat /tmp/seed-out | head -c 100)"
done <<'LINKS'
