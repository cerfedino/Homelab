{{- $app := readFile "app.enc.yaml" | fromYaml }}
{{- $host := index $app.hosts 0 }}
controllers:
  whoami:
    containers:
      app:
        image:
          repository: traefik/whoami
          tag: v1.12.0
        probes:
          readiness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /health
                port: 80
        resources:
          requests:
            memory: 16Mi
          limits:
            memory: 64Mi

service:
  app:
    controller: whoami
    ports:
      http:
        port: 80

rawResources:
  whoami:
    manifest:
      apiVersion: traefik.io/v1alpha1
      kind: IngressRoute
      spec:
        entryPoints: [lan-https, wg-private]
        routes:
          - match: Host(`{{ $host }}`)
            kind: Rule
            middlewares:
              - name: authentik-forward-auth@file
            services:
              - name: whoami
                port: 80

networkpolicies:
  namespace:
    podSelector: {}
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - podSelector: {}
  traefik:
    controller: whoami
    policyTypes: [Ingress]
    rules:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: traefik
