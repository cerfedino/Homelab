apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: paperless
spec:
  entryPoints:
    - websecure
  routes:
{{- range $variant, $v := .Values.apps.paperless }}
{{- if $v.dns_hostname }}
    - match: Host(`{{ $v.dns_hostname }}`)
      kind: Rule
      services:
        - name: paperless
          port: 8000
{{- end }}
{{- end }}
