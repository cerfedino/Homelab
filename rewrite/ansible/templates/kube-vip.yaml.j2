# kube-vip control-plane VIP (layer-2 / ARP mode) for k3s.
# k3s auto-applies anything dropped in /var/lib/rancher/k3s/server/manifests/.

# kube-vip watches nodes and holds a lease for leader election
apiVersion: v1
kind: ServiceAccount
metadata:
  name: kube-vip
  namespace: kube-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: system:kube-vip-role
rules:
  - apiGroups: [""]
    resources: ["services", "services/status", "nodes", "endpoints"]
    verbs: ["list", "get", "watch", "update"]
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    verbs: ["list", "get", "watch", "update", "create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: system:kube-vip-binding
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: system:kube-vip-role
subjects:
  - kind: ServiceAccount
    name: kube-vip
    namespace: kube-system
---


# kube-vip DaemonSet, one pod per control-plane node
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: kube-vip-ds
  namespace: kube-system
  labels:
    app.kubernetes.io/name: kube-vip-ds
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: kube-vip-ds
  template:
    metadata:
      labels:
        app.kubernetes.io/name: kube-vip-ds
    spec:
      # Only run on control-plane (server) nodes because they're the ones that can own the API VIP.
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: node-role.kubernetes.io/control-plane
                    operator: Exists
      containers:
        - name: kube-vip
          image: ghcr.io/kube-vip/kube-vip:v0.8.9
          args: ["manager"]
          env:
            - name: vip_arp            # layer-2 mode: announce via ARP
              value: "true"
            - name: port               # the API server port the VIP fronts
              value: "6443"
            - name: vip_interface      # which NIC to announce on (the LAN one)
              value: "{{ kube_vip_interface }}"
            - name: vip_cidr           # a single-host VIP
              value: "32"
            - name: cp_enable          # control-plane VIP mode (not Services)
              value: "true"
            - name: cp_namespace
              value: "kube-system"
            - name: svc_enable         # not doing LoadBalancer Services here
              value: "false"
            - name: vip_leaderelection # exactly one node owns the VIP at a time
              value: "true"
            - name: vip_leaseduration
              value: "5"
            - name: vip_renewdeadline
              value: "3"
            - name: vip_retryperiod
              value: "1"
            - name: address            # the VIP itself
              value: "{{ kube_vip_address }}"
          securityContext:
            capabilities:
              add: ["NET_ADMIN", "NET_RAW"]   # needed to bind the VIP + send ARP
      hostNetwork: true            # kube-vip manipulates the host's network stack
      serviceAccountName: kube-vip
      # Tolerate control-plane taints so it can schedule on server nodes even if
      # they're tainted / not-ready during a restart.
      tolerations:
        - effect: NoSchedule
          operator: Exists
        - effect: NoExecute
          operator: Exists
